# Projeto Supabase (Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mostra o botão "Entrar com Google" (1 = sim). Antes, ligue o provedor Google no Supabase (ver README).
VITE_LOGIN_GOOGLE=

# Notificações push (chave pública VAPID). Vazio = o app não oferece lembretes no aparelho.
VITE_VAPID_PUBLIC_KEY=
